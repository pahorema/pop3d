{
  "name": "pop3d",
  "version": "0.1.0",
  "description": "Trasforma qualsiasi luogo reale in un piccolo diorama 3D stilizzato, da esplorare, personalizzare ed esportare.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-19",
    "earcut": "^3.2.4",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "n8ao": "^2.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/bun": "^1.4.4",
    "@types/earcut": "^3.2.4",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
